      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"correo\")) {",
          "  pm.collectionVariables.set(\"correo\", \"dueno\" + Date.now() + \"@correo.com\");",
          "}"
        ]
      }
    }
